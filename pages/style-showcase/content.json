      "type": "quote",
      "props": {
        "backgroundColor": "default",
        "textColor": "default"
      },
      "content": [
        {
          "type": "text",
          "text": "A branch in Git is simply a lightweight movable pointer to one of these commits.",
          "styles": {
            "italic": true
          }
        },
        {
          "type": "text",
          "text": "  — Pro Git",
          "styles": {}
        }
      ],
      "children": []
