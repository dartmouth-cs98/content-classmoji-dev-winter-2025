      "content": [
        {
          "type": "text",
          "text": "git switch -c feature/login-form\n# ...edit files...\ngit add .\ngit commit -m \"Add login form\"\ngit push -u origin feature/login-form",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "sc-024",
      "type": "paragraph",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "Small helpers are easier to review when each commit does one thing. Here is a function that is worth its own commit:",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "sc-025",
      "type": "codeBlock",
      "props": {
        "language": "javascript",
        "copyable": true
      },
      "content": [
        {
          "type": "text",
          "text": "function branchName(type, title, issue) {\n  const slug = title.toLowerCase().trim().replace(/\\s+/g, '-');\n  return issue ? `${type}/${issue}-${slug}` : `${type}/${slug}`;\n}",
          "styles": {}
        }
      ],
      "children": []
    },
